{
  "name": "medyesa-field-backend",
  "version": "1.0.0",
  "description": "Central HTTPS API for Medyesa Field (Developed by PINARX)",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "lint": "tsc --noEmit && npm run lint:guards",
    "lint:guards": "bash scripts/lint-guards.sh"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/rate-limit": "^9.1.0",
    "@node-rs/argon2": "^2.0.2",
    "@prisma/client": "^5.22.0",
    "@types/node": "^22.9.0",
    "fastify": "^4.29.0",
    "fastify-type-provider-zod": "^2.1.0",
    "jose": "^5.9.6",
    "pino": "^9.5.0",
    "prisma": "^5.22.0",
    "typescript": "^5.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "vitest": "^2.1.5"
  }
}
