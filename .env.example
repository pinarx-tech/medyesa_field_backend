# Neon PostgreSQL 16 (AWS ap-southeast-1 Singapore)
# Pooled connection string (-pooler host) used at runtime
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=1"

# Direct connection string (no -pooler) used by prisma migrate deploy & pg_dump
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Generate with: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_64_BYTE_RANDOM_SECRET"

# Server runtime
PORT=3000
NODE_ENV="development"
LOG_LEVEL="info"

# Comma-separated allowed CORS origins (add Cloudflare Pages URL in Chunk 3)
CORS_ALLOWED_ORIGINS="http://localhost:3000"

# Requests per minute per IP
RATE_LIMIT_MAX="100"

# Optional deployment metadata injected by Render or CI
APP_VERSION="1.0.0"
RENDER_GIT_COMMIT="local"

# Seed passwords (required only when running `npx prisma db seed` — never commit real values)
SEED_PLATFORM_ADMIN_PASSWORD=""
SEED_HC_PASSWORD=""
SEED_MR_PASSWORD=""
